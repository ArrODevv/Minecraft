{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Project",
            "type": "shell",
            "command": "cmake -S . -B build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Project",
            "type": "shell",
            "command": "cmake --build build",
            "problemMatcher": [
                "$msvc",
                "$gcc",
                "$msCompile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
